/* Playlist Gen — teal/cyan on dark, no purple glow */

Screen {
    background: #0e1214;
}

Header {
    background: #141a1c;
    color: #e8eef0;
    text-style: bold;
}

Footer {
    background: #141a1c;
}

Footer > .footer--key {
    background: #1f6f78;
    color: #0e1214;
}

#setup-body {
    height: 1fr;
    layout: horizontal;
}

#playlist-pane {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    border-right: tall #1f2a2d;
}

#playlist-pane Input {
    width: 100%;
}

#btn-load {
    margin-top: 1;
    width: auto;
    min-width: 16;
}

#track-header {
    height: 1;
    width: 100%;
    align: left middle;
    margin-top: 1;
}

#track-header .field-label {
    width: 1fr;
    margin-top: 0;
    padding-top: 0;
    height: 1;
}

#track-select-btns {
    width: auto;
    height: 1;
    align: right middle;
}

#track-select-btns Button {
    width: auto;
    min-width: 6;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: #1a2426;
    color: #a8c0c6;
}

#track-select-btns Button:hover {
    background: #243033;
    color: #e8eef0;
}

#track-select-btns Button:focus {
    background: #1f6f78;
    color: #0e1214;
}

#settings-pane {
    width: 1fr;
    height: 1fr;
}

#setup-form {
    width: 100%;
    height: 1fr;
    padding: 1 2 0 2;
}

.field-label {
    margin-top: 1;
    color: #8aa0a8;
    text-style: bold;
}

#setup-form Input,
#setup-form Select {
    width: 100%;
    margin-bottom: 0;
}

#setup-form Button {
    margin-top: 1;
    margin-right: 1;
}

#btn-generate {
    width: 100%;
    height: 3;
    margin: 1 2;
}

.row {
    height: auto;
    width: 100%;
    align: left middle;
}

.row.switches {
    margin-top: 1;
    height: 3;
}

.row.switches .switch-label {
    width: auto;
    padding-top: 1;
    margin-right: 1;
    color: #8aa0a8;
}

.half {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

#track-count {
    color: #5ec8c0;
    width: 1fr;
    padding-top: 1;
}

#track-footer {
    height: 3;
    margin-top: 0;
    width: 100%;
}

#track-list {
    height: 1fr;
    border: tall #1f2a2d;
    background: #12181a;
}

#track-list:focus {
    border: tall #1f6f78;
}

#bg-list {
    height: 10;
    max-height: 12;
    border: tall #1f2a2d;
    background: #12181a;
    margin-bottom: 0;
}

#bg-list:focus {
    border: tall #1f6f78;
}

#run-body {
    padding: 1 2;
    height: 1fr;
}

#phase-label {
    height: 1;
    text-style: bold;
    color: #e8eef0;
    margin-bottom: 1;
    overflow: hidden;
}

#overall-bar {
    width: 100%;
    margin-bottom: 1;
}

.section-title {
    margin-top: 0;
    margin-bottom: 1;
    color: #8aa0a8;
    text-style: bold;
}

#run-mid {
    height: 1fr;
    width: 100%;
    margin-bottom: 1;
}

#active-pane {
    width: 2fr;
    height: 1fr;
    min-width: 40;
    padding-right: 1;
}

#tracks-pane {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
    border-left: tall #1f2a2d;
}

#slots {
    height: 1fr;
    margin-bottom: 0;
    padding: 0 1;
    background: #12181a;
    border: tall #1f2a2d;
    overflow-y: auto;
}

TrackProgressRow {
    margin: 0 0;
    width: 100%;
}

TrackProgressRow > Label {
    width: 1fr;
    min-width: 8;
    color: #a8c0c6;
    overflow: hidden;
}

TrackProgressRow > ProgressBar {
    width: 26;
    min-width: 26;
    dock: right;
}

TrackProgressRow > ProgressBar > Bar {
    width: 12;
    min-width: 12;
}

Bar > .bar--bar {
    color: #2aa8a0;
    background: #1a3030;
}

Bar > .bar--complete {
    color: #5ec8c0;
}

Bar > .bar--indeterminate {
    color: #1f6f78;
    background: #1a3030;
}

#track-table {
    height: 1fr;
    min-height: 8;
    margin-bottom: 0;
}

#run-log {
    height: 8;
    min-height: 6;
    border: tall #1f2a2d;
    background: #12181a;
}

#done-actions {
    height: auto;
    margin-top: 1;
}

#done-actions Button {
    margin-right: 1;
}

Button.-primary,
Button.-success {
    background: #1f6f78;
    color: #0e1214;
    text-style: bold;
}

Button.-success:hover,
Button.-primary:hover {
    background: #2aa8a0;
}
